#include "Controller.h"

#define DEBOUNCE_PERIOD 200

volatile uint16_t milliseconds = 0;
volatile uint8_t seconds = 0;
volatile uint8_t minutes = 0;
volatile uint8_t running = 0;
volatile uint8_t displayUpdate = 0;
volatile uint32_t lastStartStop = 0;
volatile uint32_t lastReset = 0;

int main(void)
{
    serial0_init();

    TCCR1A = 0x00;
    TCCR1B = (1 << WGM12) | (1 << CS11) | (1 << CS10);
    OCR1A = 124;
    TIMSK1 = (1 << OCIE1A);

    DDRD &= ~(1 << PD2);
    PORTD |= (1 << PD2);
    EICRA |= (1 << ISC21);
    EICRA &= ~(1 << ISC20);
    EIMSK |= (1 << INT2);

    DDRD &= ~(1 << PD3);
    PORTD |= (1 << PD3);
    EICRA |= (1 << ISC31);
    EICRA &= ~(1 << ISC30);
    EIMSK |= (1 << INT3);

    sei();

    char serialString[60] = {};

    serial0_print_string("\nStopwatch ready. Press start...");

    while(1)
    {
        if(displayUpdate)
        {
            displayUpdate = 0;
            sprintf(serialString, "\n%02u:%02u:%03u", minutes, seconds, milliseconds);
            serial0_print_string(serialString);
        }
    }

    return(1);
}

ISR(TIMER1_COMPA_vect)
{
    if(!running) return;

    milliseconds++;

    if(milliseconds >= 1000)
    {
        milliseconds = 0;
        seconds++;

        if(seconds >= 60)
        {
            seconds = 0;
            minutes++;
        }
    }

    if(milliseconds % 100 == 0)
    {
        displayUpdate = 1;
    }
}

ISR(INT2_vect)
{
    uint32_t currentTime = milliseconds_now();

    if((currentTime - lastStartStop) > DEBOUNCE_PERIOD)
    {
        running = !running;
        lastStartStop = currentTime;
    }
}

ISR(INT3_vect)
{
    uint32_t currentTime = milliseconds_now();

    if((currentTime - lastReset) > DEBOUNCE_PERIOD)
    {
        running = 0;
        milliseconds = 0;
        seconds = 0;
        minutes = 0;
        displayUpdate = 1;
        lastReset = currentTime;
    }
}
