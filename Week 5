//File: ATmega2560Project.c
//An example file for second year mechatronics project

//include this .c file's header file
#include "Controller.h"

#define DEBOUNCE_PERIOD 1000

volatile uint16_t ms = 0;
volatile uint8_t ss = 0;
volatile uint8_t mm = 0;
volatile uint8_t running = 0;
volatile uint8_t displayUpdate = 0;
volatile uint32_t lastStartStop = 0;
volatile uint32_t lastReset = 0;

int main(void)
{
    milliseconds_init();
    serial0_init();

    cli();
    TCCR1A = 0;
    TCCR1B |= (1<<WGM12)|(1<<WGM13)|(1<<CS10);
    TCNT1 = 0;
    ICR1 = 16000;
    TIMSK1 = (1<<ICIE1);
    sei();

    DDRD &= ~(1 << PD2);
    PORTD |= (1 << PD2);
    EICRA |= (1 << ISC21);
    EICRA &= ~(1 << ISC20);
    EIMSK |= (1 << INT2);

    DDRD &= ~(1 << PD3);
    PORTD |= (1 << PD3);
    EICRA |= (1 << ISC31);
    EICRA &= ~(1 << ISC30);
    EIMSK |= (1 << INT3);

    char serialString[60] = {};
    serial0_print_string("\nStopwatch ready. Press start.");

    while(1)
    {
        if(displayUpdate)
        {
            displayUpdate = 0;
            sprintf(serialString, "\n%02u:%02u:%.2u", mm, ss, ms);
            serial0_print_string(serialString);
        }
    }

    return(1);
}

ISR(TIMER1_CAPT_vect)
{
    if(running)
    {
        ms++;

        if(ms >= 1000)
        {
            ms = 0;
            ss++;

            if(ss >= 60)
            {
                ss = 0;
                mm++;
            }
        }

        if(ms % 10 == 0)
        {
            displayUpdate = 1;
        }
    }
}

ISR(INT2_vect)
{
    uint32_t currentTime = milliseconds_now();

    if((currentTime - lastStartStop) > DEBOUNCE_PERIOD)
    {
        running = !running;
        lastStartStop = currentTime;
    }
}

ISR(INT3_vect)
{
    uint32_t currentTime = milliseconds_now();

    if((currentTime - lastReset) > DEBOUNCE_PERIOD)
    {
        running = 0;
        ms = 0;
        ss = 0;
        mm = 0;
        displayUpdate = 1;
        lastReset = currentTime;
    }
}
