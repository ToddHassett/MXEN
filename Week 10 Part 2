#include "Robot.h"

void motor_pwm_init(void);
void GPIO_init(void);
void set_motors(int16_t lm, int16_t rm);

int main(void)
{
    cli();
    _delay_ms(20);
    serial0_init();
    serial2_init();
    _delay_ms(20);
    GPIO_init();
    motor_pwm_init();
    milliseconds_init();
    char serial_string[60] = {0};
    sei();

    uint8_t command = 0;
    uint8_t receivedData[4];

    while(1)
    {
        
        if(serial2_available())
        {
            serial2_get_data(receivedData, 4);
            
            // checksum covers data bytes
            if(receivedData[3] == (receivedData[0] ^ receivedData[1] ^ receivedData[2] ^ 0xFF))
            {
                command = receivedData[0];
            }
            else
            {
                command = 0x00;
            }

            if(command == 0x02)
            {
                int16_t fc = receivedData[1];
                int16_t rc = receivedData[2];

                int16_t lm = fc + rc - 253;
                int16_t rm = fc - rc;

                set_motors(lm, rm);

                sprintf(serial_string, "lm: %3d rm: %3d\n", lm, rm);
                serial0_print_string(serial_string);
            }
        }
    }
    return(0);
}

void set_motors(int16_t lm, int16_t rm)
{
    OCR1A = (int32_t)abs(lm) * 9999 / 126; //maybe try 9999
    OCR1B = (int32_t)abs(rm) * 9999 / 126;

    if(lm >= 0)
    {
        PORTA |= (1 << PA0);
        PORTA &= ~(1 << PA1);
    }
    else
    {
        PORTA &= ~(1 << PA0);
        PORTA |= (1 << PA1);
    }

    if(rm >= 0)
    {
        PORTA |= (1 << PA2);
        PORTA &= ~(1 << PA3);
    }
    else
    {
        PORTA &= ~(1 << PA2);
        PORTA |= (1 << PA3);
    }
}

void motor_pwm_init(void)
{
    TCCR1A = (1 << COM1A1) | (1 << COM1B1) | (1 << WGM11);
    TCCR1B = (1 << WGM13) | (1 << CS11);
    ICR1 = 9999;
    OCR1A = 0;
    OCR1B = 0;
}

void GPIO_init(void)
{
    DDRA |= (1 << DDA0) | (1 << DDA1) | (1 << DDA2) | (1 << DDA3);
    DDRB |= (1 << DDB5) | (1 << DDB6);
    PORTB = 0;
}
