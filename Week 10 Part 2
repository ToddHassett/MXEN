
#include "Controller.h"

void GPIO_init(void)
{
    DDRA = 0x00;
    PORTF = 0;
}

int main(void)
{
    GPIO_init();
    lcd_init();
    _delay_ms(20);
    adc_init();
    _delay_ms(20);
    serial2_init();
    serial0_init();
    milliseconds_init();

    uint8_t databyte1 = 0;
    uint8_t databyte2 = 0;
    uint8_t databyte3 = 0;
    uint16_t last_send_ms = 0;
    char serial_string[60] = {0};
    char lcd_string[33] = {0};

    lcd_clrscr();
    lcd_home();
    lcd_goto(0x00);
    lcd_puts("init");
    _delay_ms(3000);
    lcd_clrscr();

    while(1)
    {
        uint16_t current_ms = milliseconds_now();

        databyte1 = 0x02;

        uint8_t fc = (int8_t)(((uint16_t)(adc_read(PA0) >> 2) * 253) / 255);
        uint8_t rc = (int8_t)(((uint16_t)(adc_read(PA1) >> 2) * 253) / 255);

        databyte2 = fc;
        databyte3 = rc;

        if((current_ms - last_send_ms) >= 100)
        {
          sprintf(serial_string, "Sending: %3u %3u %3u\n", databyte1, databyte2, databyte3);
          serial0_print_string(serial_string);

          uint8_t check = databyte1 ^ databyte2 ^ databyte3 ^ 0xFF;
          serial2_write_bytes(4, databyte1, databyte2, databyte3, check);
          last_send_ms = current_ms;
        }

        // update LCD top line with joystick values
        lcd_goto(0x00);
        sprintf(lcd_string, "fc:%3u rc:%3u ", fc, rc);
        lcd_puts(lcd_string);

        // update LCD bottom line with direction
        lcd_goto(0x40);

        // dead zone: joystick centre is 126, threshold of 10
        int16_t fc_centred = fc - 126;
        int16_t rc_centred = rc - 126;

        if(abs(fc_centred) < 10 && abs(rc_centred) < 10)
        {
            lcd_puts("STOP     ");
        }
        else if(abs(rc_centred) > abs(fc_centred))
        {
            if(rc_centred > 0)
                lcd_puts("RIGHT   ");
                
            else
                lcd_puts("LEFT   ");
        }
        else if (fc_centred > 0 && abs(rc_centred) < 10)
        {
            lcd_puts("REVERSE  ");
        }
        else
        {
            lcd_puts("FORWARD  ");
        }
    }
    return(0);
}


