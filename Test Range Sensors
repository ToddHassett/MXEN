/*
 * test_range.c
 * MXEN2003 - Sharp IR Range Sensor Test
 *
 * WIRING:
 *   Front sensor GP2Y0A21YK (10-80cm)  VO -> A0
 *   Left  sensor GP2D120    (4-30cm)   VO -> A4
 *   Right sensor GP2D120    (4-30cm)   VO -> A5
 *   Each sensor: VCC=5V, GND=GND
 */

#include "Robot.h"

#define FRONT_SENSOR_PIN    4       /* A2 - GP2Y0A21YK */
#define LEFT_SENSOR_PIN     3       /* A3 - GP2D120    */
#define RIGHT_SENSOR_PIN    2       /* A4 - GP2D120    */

int main(void)
{
    adc_init();
    serial0_init();
    milliseconds_init();

    char serialString[100] = {};

    while (1)
    {
        /* Read raw ADC values from each sensor */
        uint16_t raw_front = adc_read(FRONT_SENSOR_PIN);
        uint16_t raw_left = adc_read(RIGHT_SENSOR_PIN);
        uint16_t raw_right = adc_read(LEFT_SENSOR_PIN);


        uint16_t dist_front = ((10650.08 / (raw_front - 14.57)) - 12.4) / 1.4;
        uint16_t dist_right = ((2585/raw_right) - 1);
        uint16_t dist_left = ((2585/raw_left) - 1);

        /* Print all three distances */
        sprintf(serialString, "\nRight: %d cm, Left: %d, Front: %d", dist_left, dist_right, dist_front);
        serial0_print_string(serialString);

        _delay_ms(100);
    }

    return 0;
}
