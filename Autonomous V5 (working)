/*
 * maze_follower.c
 * Autonomous maze navigation - no controller.
 *
 * Sensors:
 *   Front (GP2Y0A21YK, 10-80 cm)  -> ADC2
 *   Right (GP2D120,    4-30 cm)   -> ADC3
 *   Left  (GP2D120,    4-30 cm)   -> ADC4
 *
 * Motors:
 *   OCR1A = left  wheel PWM
 *   OCR1B = right wheel PWM
 *   PA0/PA1 = left  direction
 *   PA2/PA3 = right direction
 */

#include "Robot.h"

/* ---- sensor pins (ADC channel numbers) ---- */
#define FRONT_PIN       2
#define RIGHT_PIN       3
#define LEFT_PIN        4

/* ---- distance thresholds (cm) ---- */
#define FRONT_STOP_CM   15      /* start turning when wall is this close */
#define FRONT_MAX_CM    80      /* clamp front reading to this */

/* ---- motor speeds (0-100 scale) ---- */
#define BASE_SPEED      70

/* ---- LED ---- */
#define LED_PIN         PB0

void motor_pwm_init(void);
void GPIO_init(void);
void set_motors(int16_t lm, int16_t rm);

uint16_t read_front_cm(void);
uint16_t read_right_cm(void);
uint16_t read_left_cm(void);

int main(void)
{
    cli();
    _delay_ms(20);
    serial0_init();
    _delay_ms(20);
    GPIO_init();
    adc_init();
    motor_pwm_init();
    milliseconds_init();
    sei();

    char buf[80] = {0};

    static uint16_t prev_front = 999;
    static uint16_t prev_right = 999;
    static uint16_t prev_left  = 999;

    while (1)
    {
        uint16_t front = read_front_cm();
        uint16_t right = read_right_cm();
        uint16_t left  = read_left_cm();
        uint32_t a1    = adc_read(1) * 4.88 * 2 ;
        if (a1 < 7000)
            PORTB |=  (1 << LED_PIN);
        else
            PORTB &= ~(1 << LED_PIN);


        int16_t lm = 0;
        int16_t rm = 0;
        static int8_t turn_dir = 0;   /* -1 = right, +1 = left, 0 = none */

        if (left > 50)
        {
            left = 999;
        }
        if (right > 50)
        {
            right = 999;
        }
        if (front > 85)
        {
            front = 999;
        }

        /* require two consecutive sub-999 readings before accepting */
        uint16_t raw_front = front;
        uint16_t raw_right = right;
        uint16_t raw_left  = left;

        if (front < 999 && prev_front == 999) front = 999;
        if (right < 999 && prev_right == 999) right = 999;
        if (left  < 999 && prev_left  == 999) left  = 999;

        prev_front = raw_front;
        prev_right = raw_right;
        prev_left  = raw_left;


        if (front < 13)
        {
            if (turn_dir == 0)
            {
                set_motors(0, 0);

                uint32_t sum_left = 0, sum_right = 0;
                for (uint8_t i = 0; i < 10; i++)
                {
                    sum_left  += read_left_cm();
                    sum_right += read_right_cm();
                    _delay_ms(20);
                }
                uint16_t avg_left  = sum_left  / 10;
                uint16_t avg_right = sum_right / 10;

                turn_dir = (avg_left > avg_right) ? 1 : -1;
            }

            if (turn_dir == 1)
            {
                lm = BASE_SPEED;
                rm = -BASE_SPEED;
                _delay_ms(600);
            }
            else
            {
                lm = -BASE_SPEED;
                rm = BASE_SPEED;
                _delay_ms(600);
            }
        }
        else if (left < 8)
        {
            turn_dir = 0;
            lm = BASE_SPEED;
            rm = - 20;
        }
        else if (right < 8)
        {
            turn_dir = 0;
            lm = - 20;
            rm = BASE_SPEED;
        }
        else if ((left < 20) && (right < 20))
        {
            turn_dir = 0;
            lm = BASE_SPEED - (70 * 5 / right);
            rm = BASE_SPEED - (70 * 5 / left);
        }
        
        else if (left < 20)
        {
            turn_dir = 0;
            lm = BASE_SPEED - 20;
            rm = BASE_SPEED - 20;
        }
        else if (right < 20)
        {
            turn_dir = 0;
            lm = BASE_SPEED - 20;
            rm = BASE_SPEED - 20;
        }
        else
        {
            turn_dir = 0;
            lm = BASE_SPEED;
            rm = BASE_SPEED;
        }
        



        if (abs(lm) < 30)
        {
            lm = 0;
        }
        if (abs(rm) < 30)
        {
            rm = 0;
        }

        
        set_motors(rm, lm);
        
        


        sprintf(buf, "F:%3u L:%3u R:%3u | lm:%3d rm:%3d | A1:%4lu\n",
                front, left, right, rm, lm, a1);
        serial0_print_string(buf);
        _delay_ms(100);
    }

    return 0;
}

/* ---- distance helpers ---- */

uint16_t read_front_cm(void)
{
    uint16_t raw = (adc_read(FRONT_PIN) + adc_read(FRONT_PIN) + adc_read(FRONT_PIN)) / 3;
    if (raw <= 10) return 999;
    int16_t cm = (int16_t)(((10650.08 / (raw - 14.57)) - 12.4) / 1.4);
    if (cm < 0) return 999;
    return (uint16_t)cm;
}

uint16_t read_right_cm(void)
{
    uint16_t raw = (adc_read(RIGHT_PIN) + adc_read(RIGHT_PIN) + adc_read(RIGHT_PIN)) / 3;
    if (raw == 0) return 999;
    int16_t cm = (int16_t)((2585 / raw) - 1);
    if (cm < 0) return 999;
    return (uint16_t)cm;
}

uint16_t read_left_cm(void)
{
    uint16_t raw = (adc_read(LEFT_PIN) + adc_read(LEFT_PIN) + adc_read(LEFT_PIN)) / 3;
    if (raw == 0) return 999;
    int16_t cm = (int16_t)((2585 / raw) - 1);
    if (cm < 0) return 999;
    return (uint16_t)cm;
}

/* ---- motor and GPIO setup ---- */

void set_motors(int16_t lm, int16_t rm)
{
    OCR1A = (int32_t)abs(lm) * 9999 / 100;
    OCR1B = (int32_t)abs(rm) * 9999 / 100;

    if (lm >= 0)
    {
        PORTA |=  (1 << PA0);
        PORTA &= ~(1 << PA1);
    }
    else
    {
        PORTA &= ~(1 << PA0);
        PORTA |=  (1 << PA1);
    }

    if (rm >= 0)
    {
        PORTA |=  (1 << PA2);
        PORTA &= ~(1 << PA3);
    }
    else
    {
        PORTA &= ~(1 << PA2);
        PORTA |=  (1 << PA3);
    }
}

void motor_pwm_init(void)
{
    TCCR1A = (1 << COM1A1) | (1 << COM1B1) | (1 << WGM11);
    TCCR1B = (1 << WGM13)  | (1 << CS11);
    ICR1   = 9999;
    OCR1A  = 0;
    OCR1B  = 0;
}

void GPIO_init(void)
{
    DDRA |= (1 << DDA0) | (1 << DDA1) | (1 << DDA2) | (1 << DDA3);
    DDRB |= (1 << DDB0) | (1 << DDB5) | (1 << DDB6);
    PORTB = 0;
}
