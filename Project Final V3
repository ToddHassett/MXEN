/*
 * Robot.c  -  Rover for MXEN2003 project (two-mode version)
 *
 * Modes (selected by controller via flags bit 0):
 *   MANUAL    : drive from received wheel values, servo from flag bit 1
 *   AUTONOMOUS: wall-follow the maze (FORWARD <-> TURN). LDRs sample
 *               continuously so any beacon driven past is detected
 *               passively and its frequency is sent back to the controller.
 *
 * Sensors:
 *   Front IR (GP2Y0A21YK, 10-80cm) -> ADC2
 *   Right IR (GP2D120,    4-30cm)  -> ADC3
 *   Left  IR (GP2D120,    4-30cm)  -> ADC4
 *   Left  LDR                      -> ADC5
 *   Right LDR                      -> ADC6
 *   Battery divider                -> ADC1
 *
 * Outputs:
 *   Motor PWM    -> OC1A (PB5) left, OC1B (PB6) right
 *   Motor dir    -> PA0..PA3
 *   Servo        -> OC3A (PE3 / D5)
 *   Low-batt LED -> PB0 (D53 on Mega header)
 *
 * Packet from controller (5 bytes, every 100 ms):
 *   [0x02, right_wheel, left_wheel, flags, checksum]
 *     flags bit 0 = autonomous mode
 *     flags bit 1 = servo open
 *
 * Packet to controller (5 bytes, every 100 ms):
 *   [0x10, voltage_dV, freq_left_hz, freq_right_hz, checksum]
 */

#include "Robot.h"

/* ---- Pin / ADC channel definitions ---- */
#define BATT_PIN            1
#define LDR_LEFT_PIN        2
#define LDR_RIGHT_PIN       3
#define RIGHT_PIN           4
#define LEFT_PIN            5
#define FRONT_PIN           6

/* ---- Navigation tunables ---- */
#define FRONT_STOP_CM       8
#define WALL_TRACK_CM       13
#define WALL_AVOID_CM       7
#define BASE_SPEED          60
#define TURN_SPEED          60
#define TRACK_KP            20
#define TURN_90_MS          900

/* ---- Battery ---- */
#define BATT_LOW_MV         7000
#define LOW_BATT_LED_DDR    DDRB
#define LOW_BATT_LED_PORT   PORTB
#define LOW_BATT_LED_PIN    PB0
#define BEACON_LED_DDR      DDRB
#define BEACON_LED_PORT     PORTB
#define BEACON_LED_PIN      PB1

/* ---- Servo ---- */
#define SERVO_TOP           39999
#define SERVO_CLOSED        2000
#define SERVO_OPEN          3000

/* ---- Beacon detection ---- */
#define BEACON_PERIOD_MIN   25      /* ~40 Hz upper cutoff with margin */
#define BEACON_PERIOD_MAX   500     /* 2 Hz lower bound                */
#define FREQ_CONFIRM_COUNT  3
#define BEACON_LED_COUNT    10
#define LDR_MIN_RANGE       50

/* ---- Packet sizes ---- */
#define PACKET_RX_BYTES     5
#define PACKET_TX_BYTES     5

typedef enum { STATE_FORWARD, STATE_TURN } NavState;

/* ---- Forward declarations ---- */
void     motor_pwm_init(void);
void     servo_pwm_init(void);
void     GPIO_init(void);
void     set_motors(int16_t lm, int16_t rm);
uint16_t read_front_cm(void);
uint16_t read_right_cm(void);
uint16_t read_left_cm(void);

/* ---- LDR / beacon state ---- */
static uint8_t  ldr_state[2]       = {0, 0};
static uint32_t ldr_last_rising[2] = {0, 0};
static uint32_t ldr_period[2]      = {0, 0};
static uint8_t  ldr_confirm[2]     = {0, 0};
static uint8_t  ldr_freq_hz[2]     = {0, 0};
static uint16_t ldr_min[2]         = {1023, 1023};
static uint16_t ldr_max[2]         = {0, 0};
static uint8_t  beacon_led_on      = 0;

static void update_ldr(uint8_t idx, uint16_t adc_val, uint32_t now_ms)
{
    /* Adaptive min/max with slow decay so ambient drift doesn't kill detection. */
    if (adc_val < ldr_min[idx])
    {
        ldr_min[idx] = adc_val;
    }
    else if ((now_ms % 10) == 0 && ldr_min[idx] < 1022)
    {
        ldr_min[idx]++;
    }

    if (adc_val > ldr_max[idx])
    {
        ldr_max[idx] = adc_val;
    }
    else if ((now_ms % 10) == 0 && ldr_max[idx] > 1)
    {
        ldr_max[idx]--;
    }

    uint16_t range = ldr_max[idx] - ldr_min[idx];
    if (range < LDR_MIN_RANGE)
    {
        ldr_freq_hz[idx] = 0;
        ldr_confirm[idx] = 0;
        return;
    }

    uint16_t threshold = ldr_min[idx] + range / 2;
    uint8_t new_state;
    if (adc_val > threshold)
    {
        new_state = 1;
    }
    else
    {
        new_state = 0;
    }
    if (new_state == ldr_state[idx])
    {
        return;
    }

    if (new_state == 1)
    {
        if (ldr_last_rising[idx] > 0)
        {
            uint32_t period = now_ms - ldr_last_rising[idx];
            if (period >= BEACON_PERIOD_MIN && period <= BEACON_PERIOD_MAX)
            {
                uint32_t diff = (uint32_t)labs((int32_t)period - (int32_t)ldr_period[idx]);
                if (ldr_confirm[idx] == 0 || diff < (ldr_period[idx] / 3))
                {
                    ldr_period[idx] = period;
                    ldr_confirm[idx]++;
                    if (ldr_confirm[idx] >= FREQ_CONFIRM_COUNT)
                    {
                        ldr_freq_hz[idx] = (uint8_t)((1000 + ldr_period[idx]/2) / ldr_period[idx]);
                    }
                    if (ldr_confirm[idx] >= BEACON_LED_COUNT)
                    {
                        beacon_led_on = 1;
                    }
                }
                else
                {
                    ldr_period[idx]  = period;
                    ldr_confirm[idx] = 1;
                }
            }
            else
            {
                ldr_confirm[idx] = 0;
                ldr_freq_hz[idx] = 0;
                ldr_period[idx]  = 0;
            }
        }
        ldr_last_rising[idx] = now_ms;
    }
    ldr_state[idx] = new_state;
}

int main(void)
{
    cli();
    _delay_ms(20);
    serial0_init();
    serial2_init();
    _delay_ms(20);
    GPIO_init();
    adc_init();
    motor_pwm_init();
    servo_pwm_init();
    milliseconds_init();
    sei();

    char     serial_string[80] = {0};
    uint8_t  receivedData[PACKET_RX_BYTES];
    uint16_t last_send_ms     = 0;
    uint8_t  last_servo_state = 0xFF;

    /* Latest values from controller */
    uint8_t  autonomous_mode = 1;
    uint8_t  servo_open      = 0;
    int16_t  manual_lm       = 0;
    int16_t  manual_rm       = 0;

    /* Autonomous state */
    NavState state         = STATE_FORWARD;
    int8_t   turn_dir      = 0;
    uint32_t turn_start_ms = 0;

    uint16_t prev_front = 999;
    uint16_t prev_right = 999;
    uint16_t prev_left  = 999;

    uint32_t batt_mV = 0;

    serial0_print_string("Robot ready\n");

    while (1)
    {
        uint32_t now = milliseconds_now();

        /* ============================================================== */
        /*  Beacon LDR sampling -- ALWAYS, every loop, regardless of mode  */
        /* ============================================================== */
        update_ldr(0, adc_read(LDR_LEFT_PIN),  now);
        update_ldr(1, adc_read(LDR_RIGHT_PIN), now);

        /* ============================================================== */
        /*  Battery monitor + low-battery LED                              */
        /* ============================================================== */
        uint16_t adcVal = adc_read(BATT_PIN);
        batt_mV = (uint32_t)adcVal * 5000 / 1023 * 2;
        if (batt_mV < BATT_LOW_MV)
        {
            LOW_BATT_LED_PORT |= (1 << LOW_BATT_LED_PIN);
        }
        else
        {
            LOW_BATT_LED_PORT &= ~(1 << LOW_BATT_LED_PIN);
        }
        if (beacon_led_on)
        {
            BEACON_LED_PORT |= (1 << BEACON_LED_PIN);
        }

        /* ============================================================== */
        /*  Receive controller packet                                      */
        /* ============================================================== */
        if (serial2_available())
        {
            serial2_get_data(receivedData, PACKET_RX_BYTES);
            uint8_t check = receivedData[0] ^ receivedData[1] ^ receivedData[2] ^ receivedData[3] ^ 0xFF;
            if (receivedData[4] == check && receivedData[0] == 0x02)
            {
                manual_rm       = (int8_t)receivedData[1];
                manual_lm       = (int8_t)receivedData[2];
                uint8_t flags   = receivedData[3];
                autonomous_mode = (flags >> 0) & 0x01;
                servo_open      = (flags >> 1) & 0x01;

                if (!autonomous_mode)
                {
                    state = STATE_FORWARD;
                }
            }
        }

        /* ============================================================== */
        /*  Servo update on change                                         */
        /* ============================================================== */
        if (servo_open != last_servo_state)
        {
            last_servo_state = servo_open;
            if (servo_open)
            {
                OCR3A = SERVO_OPEN;
            }
            else
            {
                OCR3A = SERVO_CLOSED;
            }
        }

        /* ============================================================== */
        /*  Drive selection                                                */
        /* ============================================================== */
        int16_t lm = 0, rm = 0;
        uint16_t front = 999, right = 999, left = 999;

        if (!autonomous_mode)
        {
            lm = manual_lm;
            rm = manual_rm;
        }
        else
        {
            /* ---- Read & filter range sensors ---- */
            front = read_front_cm();
            right = read_right_cm();
            left  = read_left_cm();

            if (left > 50)
            {
                left = 999;
            }
            if (right > 50)
            {
                right = 999;
            }
            if (front > 85)
            {
                front = 999;
            }

            uint16_t raw_front = front, raw_right = right, raw_left = left;
            if (front < 999 && prev_front == 999)
            {
                front = 999;
            }
            if (right < 999 && prev_right == 999)
            {
                right = 999;
            }
            if (left < 999 && prev_left == 999)
            {
                left = 999;
            }
            prev_front = raw_front;
            prev_right = raw_right;
            prev_left  = raw_left;

            switch (state)
            {
                case STATE_FORWARD:
                    if (front < FRONT_STOP_CM)
                    {
                        set_motors(0, 0);
                        /* Pick the more open side for the 90 deg spin. */
                        uint32_t sl = 0, sr = 0;
                        for (uint8_t i = 0; i < 10; i++) 
                        {
                            uint16_t l = read_left_cm();
                            uint16_t r = read_right_cm();
                            if (l < 999)
                            {
                                sl += l;
                            }
                            else
                            {
                                sl += 80;
                            }
                            if (r < 999)
                            {
                                sr += r;
                            }
                            else
                            {
                                sr += 80;
                            }
                            _delay_ms(20);
                        }
                        if (sl > sr)
                        {
                            turn_dir = 1;
                        }
                        else
                        {
                            turn_dir = -1;
                        }
                        turn_start_ms = milliseconds_now();
                        state         = STATE_TURN;
                        break;
                    }

                    {
                        bool lv = (left  < 999);
                        bool rv = (right < 999);

                        int16_t error = 0;
                        if (lv && rv)
                        {
                            error = left - right;
                        }
                        else if (lv)
                        {
                            error = left - WALL_TRACK_CM;
                        }
                        else if (rv)
                        {
                            error = WALL_TRACK_CM - right;
                        }

                        int16_t correction = TRACK_KP * error;
                        if (correction > BASE_SPEED)
                        {
                            correction = BASE_SPEED;
                        }
                        if (correction < -BASE_SPEED)
                        {
                            correction = -BASE_SPEED;
                        }

                        lm = BASE_SPEED + correction;
                        rm = BASE_SPEED - correction;

                        if (left < WALL_AVOID_CM)
                        {
                            lm = BASE_SPEED / 2;
                            rm = BASE_SPEED;
                        }
                        else if (right < WALL_AVOID_CM)
                        {
                            lm = BASE_SPEED;
                            rm = BASE_SPEED / 2;
                        }

                        if (lm < 0)
                        {
                            lm = 0;
                        }
                        if (rm < 0)
                        {
                            rm = 0;
                        }
                        if (lm > BASE_SPEED)
                        {
                            lm = BASE_SPEED;
                        }
                        if (rm > BASE_SPEED)
                        {
                            rm = BASE_SPEED;
                        }
                    }
                    break;

                case STATE_TURN:
                    if (turn_dir == 1)
                    {
                        lm = -TURN_SPEED;
                        rm =  TURN_SPEED;
                    }
                    else
                    {
                        lm =  TURN_SPEED;
                        rm = -TURN_SPEED;
                    }
                    if (milliseconds_now() - turn_start_ms >= TURN_90_MS)
                    {
                        lm    = 0;
                        rm    = 0;
                        state = STATE_FORWARD;
                    }
                    break;
            }
        }

        set_motors(lm, rm);

        if ((uint16_t)((uint16_t)now - last_send_ms) >= 100)
        {
            uint8_t voltage_dV = (uint8_t)(batt_mV / 50);
            uint8_t fl = ldr_freq_hz[0];
            uint8_t fr = ldr_freq_hz[1];
            uint8_t check = 0x10 ^ voltage_dV ^ fl ^ fr ^ 0xFF;
            serial2_write_bytes(PACKET_TX_BYTES, 0x10, voltage_dV, fl, fr, check);
            last_send_ms = (uint16_t)now;

            char mode_char;
            if (autonomous_mode)
            {
                mode_char = 'A';
            }
            else
            {
                mode_char = 'M';
            }
            sprintf(serial_string,
                    "mode:%c st:%d F:%u L:%u R:%u lm:%d rm:%d V:%lumV\n",
                    mode_char,
                    (int)state, front, left, right, lm, rm, batt_mV);
            serial0_print_string(serial_string);
        }
    }
    return 0;
}

uint16_t read_front_cm(void)
{
    uint16_t raw = (adc_read(FRONT_PIN) + adc_read(FRONT_PIN) + adc_read(FRONT_PIN)) / 3;
    if (raw <= 10)
    {
        return 999;
    }
    int16_t cm = (int16_t)(((10650.08 / (raw - 14.57)) - 12.4) / 1.4);
    if (cm < 0)
    {
        return 999;
    }
    return (uint16_t)cm;
}

uint16_t read_right_cm(void)
{
    uint16_t raw = (adc_read(RIGHT_PIN) + adc_read(RIGHT_PIN) + adc_read(RIGHT_PIN)) / 3;
    if (raw == 0)
    {
        return 999;
    }
    int16_t cm = (int16_t)((2585 / raw) - 1);
    if (cm < 0)
    {
        return 999;
    }
    return (uint16_t)cm;
}

uint16_t read_left_cm(void)
{
    uint16_t raw = (adc_read(LEFT_PIN) + adc_read(LEFT_PIN) + adc_read(LEFT_PIN)) / 3;
    if (raw == 0)
    {
        return 999;
    }
    int16_t cm = (int16_t)((2585 / raw) - 1);
    if (cm < 0)
    {
        return 999;
    }
    return (uint16_t)cm;
}

void set_motors(int16_t lm, int16_t rm)
{
    OCR1A = (int32_t)abs(lm) * 9999 / 100;
    OCR1B = (int32_t)abs(rm) * 9999 / 100;

    if (lm >= 0)
    {
        PORTA |=  (1 << PA0);
        PORTA &= ~(1 << PA1);
    }
    else
    {
        PORTA &= ~(1 << PA0);
        PORTA |=  (1 << PA1);
    }

    if (rm >= 0)
    {
        PORTA |=  (1 << PA2);
        PORTA &= ~(1 << PA3);
    }
    else
    {
        PORTA &= ~(1 << PA2);
        PORTA |=  (1 << PA3);
    }
}

void motor_pwm_init(void)
{
    TCCR1A = (1 << COM1A1) | (1 << COM1B1) | (1 << WGM11);
    TCCR1B = (1 << WGM13)  | (1 << CS11);
    ICR1   = 9999;
    OCR1A  = 0;
    OCR1B  = 0;
}

void servo_pwm_init(void)
{
    DDRE |= (1 << DDE3);
    TCCR3A = (1 << COM3A1) | (1 << WGM31);
    TCCR3B = (1 << WGM33)  | (1 << WGM32) | (1 << CS31);
    ICR3   = SERVO_TOP;
    OCR3A  = SERVO_CLOSED;
}

void GPIO_init(void)
{
    /* Motor direction outputs */
    DDRA |= (1 << DDA0) | (1 << DDA1) | (1 << DDA2) | (1 << DDA3);

    /* Motor PWM outputs + low-battery LED + beacon LED */
    DDRB |= (1 << DDB5) | (1 << DDB6);
    LOW_BATT_LED_DDR |= (1 << LOW_BATT_LED_PIN);
    BEACON_LED_DDR   |= (1 << BEACON_LED_PIN);
    PORTB = 0;
}





/*
 * Controller.c
 * Joystick remote controller for rover.
 *
 * LEFT JOYSTICK:
 *   A15 (PK7, ch15) = Y axis (forward/back)
 *   A14 (PK6, ch14) = X axis (left/right)
 *   Button on D20 (PD1 / INT1) – toggles MANUAL / AUTO mode
 *
 * RIGHT JOYSTICK:
 *   A0  (PA0, ch0)  = Y axis – up opens servo, down closes servo (manual mode only)
 *   A1  (PA1, ch1)  = X axis (unused)
 *   Button on D21 (PD0 / INT0) – prints current beacon frequency to LCD
 *
 * LCD LINE 1: current mode  (MANUAL / AUTO)
 * LCD LINE 2: beacon frequency or "SEARCHING..."
 *
 * PACKET OUT (controller -> robot, 4 bytes):
 *   [0] databyte1 = 0x02 | (servo_open << 2) | (mode_auto << 3)
 *   [1] right_wheel  (int8_t cast to uint8_t)
 *   [2] left_wheel   (int8_t cast to uint8_t)
 *   [3] checksum = [0]^[1]^[2]^0xFF
 *
 * PACKET IN (robot -> controller, 3 bytes):
 *   [0] 0x10
 *   [1] battery_byte  (mV / 100, so 74 = 7.4 V)
 *   [2] checksum = [0]^[1]^0xFF
 *
 * SERVO (manual mode):
 *   Right joystick Y > +SERVO_THRESH  -> open
 *   Right joystick Y < -SERVO_THRESH  -> close
 *   Dead zone in between holds last state.
 *
 * BATTERY ALERT:
 *   LCD line 1 shows "LOW BATT!" when voltage < 7.0 V,
 *   overriding the mode display for 2 s.
 */

#include "Controller.h"

/* ---- Joystick ADC channels ---- */
#define JOY_L_Y_CH     15    /* A15 (PK7, ch15) – left  Y (forward/back) */
#define JOY_L_X_CH     14    /* A14 (PK6, ch14) – left  X (left/right)   */
#define JOY_R_Y_CH      0    /* A0  (PA0, ch0)  – right Y (servo)        */

/* ---- Joystick dead zones ---- */
#define JOY_DEAD        10   /* centre dead zone (counts after centering) */
#define SERVO_THRESH    40   /* right joystick Y threshold for servo      */

/* ---- Battery alert ---- */
#define BATT_ALERT_BYTE 70   /* 70 = 7.0 V (byte units are mV/100) */
#define BATT_ALERT_MS   2000

/* ================================================================ */

volatile uint8_t mode_auto    = 1;   /* 1 = AUTO, 0 = MANUAL  – toggled by INT1 */
volatile uint8_t show_freq    = 0;   /* set by INT0 (right button)               */

/* ================================================================ */

void GPIO_init(void)
{
    /* Right joystick: A0/A1 on Port A – inputs, no pull-ups */
    DDRA  = 0x00;
    PORTA = 0x00;

    /* Left joystick: A14/A15 (PK6/PK7) on Port K – inputs, no pull-ups */
    DDRK  &= ~((1 << PK6) | (1 << PK7));
    PORTK &= ~((1 << PK6) | (1 << PK7));

    /* Left joystick button: PD1 (D20), input + pull-up */
    DDRD  &= ~(1 << PD1);
    PORTD |=  (1 << PD1);

    /* Right joystick button: PD0 (D21), input + pull-up */
    DDRD  &= ~(1 << PD0);
    PORTD |=  (1 << PD0);

    /* INT1 (PD1): falling edge – left button */
    EICRA |=  (1 << ISC11);
    EICRA &= ~(1 << ISC10);
    EIMSK |=  (1 << INT1);

    /* INT0 (PD0): falling edge – right button */
    EICRA |=  (1 << ISC01);
    EICRA &= ~(1 << ISC00);
    EIMSK |=  (1 << INT0);
}

/* Left joystick button: toggle mode */
ISR(INT1_vect)
{
    mode_auto = !mode_auto;
}

/* Right joystick button: flag to display frequency */
ISR(INT0_vect)
{
    show_freq = 1;
}

/* ================================================================ */

int main(void)
{
    GPIO_init();
    lcd_init();
    _delay_ms(20);
    adc_init();
    _delay_ms(20);
    serial2_init();
    serial0_init();
    milliseconds_init();
    sei();

    uint8_t  databyte1     = 0;
    uint8_t  databyte2     = 0;
    uint8_t  databyte3     = 0;
    uint8_t  receivedData[3];
    uint16_t last_send_ms  = 0;
    char     buf[33]       = {0};
    char     serial_buf[60]= {0};

    /* Servo state: 0 = closed, 1 = open. Driven by right joystick Y. */
    uint8_t  servo_open    = 0;

    /* Beacon frequency received from robot */
    uint8_t  beacon_freq   = 0;    /* Hz, 0 = not detected */

    /* Battery */
    uint8_t  batt_byte     = 0;
    uint32_t batt_alert_start = 0;
    uint8_t  batt_alert_active = 0;

    lcd_clrscr();
    lcd_home();
    lcd_puts("Initialising...");
    _delay_ms(2000);
    lcd_clrscr();

    while (1)
    {
        uint16_t current_ms = (uint16_t)milliseconds_now();

        /* ---- Read left joystick for motor mixing ---- */
        int16_t lx = (int16_t)(adc_read(JOY_L_X_CH) >> 2) - 126;
        int16_t ly = (int16_t)(adc_read(JOY_L_Y_CH) >> 2) - 126;

        /* Dead zone */
        if (lx > -JOY_DEAD && lx < JOY_DEAD) lx = 0;
        if (ly > -JOY_DEAD && ly < JOY_DEAD) ly = 0;

        int16_t left_wheel  = ly - lx;
        int16_t right_wheel = ly + lx;

        if (left_wheel  >  100) left_wheel  =  100;
        if (left_wheel  < -100) left_wheel  = -100;
        if (right_wheel >  100) right_wheel =  100;
        if (right_wheel < -100) right_wheel = -100;

        /* ---- Read right joystick Y for servo (manual only) ---- */
        if (!mode_auto)
        {
            int16_t ry = (int16_t)(adc_read(JOY_R_Y_CH) >> 2) - 126;
            if      (ry > SERVO_THRESH)  servo_open = 1;
            else if (ry < -SERVO_THRESH) servo_open = 0;
            /* dead zone: hold last state */
        }

        /* ---- Build and send packet every 100 ms ---- */
        databyte1 = 0x02
                  | ((servo_open & 0x01) << 2)
                  | ((mode_auto  & 0x01) << 3);
        databyte2 = (uint8_t)right_wheel;
        databyte3 = (uint8_t)left_wheel;

        if ((uint16_t)(current_ms - last_send_ms) >= 100)
        {
            uint8_t check = databyte1 ^ databyte2 ^ databyte3 ^ 0xFF;
            serial2_write_bytes(4, databyte1, databyte2, databyte3, check);
            last_send_ms = current_ms;

            sprintf(serial_buf, "Mode:%s L:%4d R:%4d Servo:%s\n",
                    mode_auto ? "AUTO  " : "MANUAL",
                    left_wheel, right_wheel,
                    servo_open ? "OPEN" : "CLSD");
            serial0_print_string(serial_buf);
        }

        /* ---- Receive robot telemetry ---- */
        if (serial2_available())
        {
            serial2_get_data(receivedData, 3);
            if (receivedData[2] == (receivedData[0] ^ receivedData[1] ^ 0xFF)
                && receivedData[0] == 0x10)
            {
                batt_byte = receivedData[1];

                /* Battery alert */
                if (batt_byte < BATT_ALERT_BYTE)
                {
                    if (!batt_alert_active) {
                        batt_alert_start  = milliseconds_now();
                        batt_alert_active = 1;
                    }
                }
                else
                {
                    batt_alert_active = 0;
                }
            }
        }

        /* ---- Note: beacon frequency is detected on the ROBOT side.
                The robot logs it via serial0. To display it here we
                would need an extra byte in the telemetry packet.
                For now, show_freq button displays the last value
                received if you extend the protocol; placeholder below. ---- */

        /* ---- Update LCD ---- */

        /* LINE 1: mode or battery alert */
        lcd_goto(0x00);

        if (batt_alert_active &&
            (milliseconds_now() - batt_alert_start) < BATT_ALERT_MS)
        {
            lcd_puts("LOW BATT!  ");
        }
        else
        {
            batt_alert_active = 0;
            uint16_t batt_mv_disp = (uint16_t)batt_byte * 100;

            if (mode_auto)
                sprintf(buf, "AUTO  %u.%uV  ", batt_mv_disp / 1000,
                        (batt_mv_disp % 1000) / 100);
            else
            {
                /* Show direction in manual mode */
                const char *dir;
                if      (ly == 0 && lx == 0) dir = "STOP   ";
                else if (lx != 0 && abs(lx) > abs(ly))
                    dir = (lx > 0) ? "RIGHT  " : "LEFT   ";
                else
                    dir = (ly < 0) ? "FWD    " : "REV    ";
                sprintf(buf, "MAN %s", dir);
            }
            lcd_puts(buf);
        }

        /* LINE 2: frequency */
        lcd_goto(0x40);

        if (show_freq || mode_auto)
        {
            /* beacon_freq would come from an extended telemetry packet.
               Until the protocol is extended, display a placeholder.
               Replace 'beacon_freq' with the real received value. */
            if (beacon_freq > 0)
                sprintf(buf, "BCN: %2u Hz      ", beacon_freq);
            else
                lcd_puts("SEARCHING...    ");
        }
        else
        {
            /* Manual, button not pressed: show servo state */
            sprintf(buf, "Servo: %s   ", servo_open ? "OPEN  " : "CLOSED");
            lcd_puts(buf);
        }
    }

    return 0;
}
