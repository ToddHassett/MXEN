#include "Robot.h"

void motor_pwm_init(void);
void GPIO_init(void);
void set_motors(int16_t lm, int16_t rm);

int main(void)
{
    cli();
    _delay_ms(20);
    serial0_init();
    serial2_init();
    _delay_ms(20);
    GPIO_init();
    motor_pwm_init();
    char serial_string[60] = {0};
    sei();

    uint8_t command = 0;
    uint8_t receivedData[4];

    while(1)
    {
        if(serial2_available())
        {
            serial2_get_data(receivedData, 4);

            // Validate checksum: all three data bytes XOR'd against 0xFF
            if(receivedData[3] == (receivedData[0] ^ receivedData[1] ^ receivedData[2] ^ 0xFF))
            {
                command = receivedData[0];
            }
            else
            {
                command = 0x00;
            }

            if(command == 0x02)
            {
                int16_t fc = (int16_t)receivedData[1];
                int16_t rc = (int16_t)receivedData[2];

                int16_t lm = fc + rc - 253;
                int16_t rm = fc - rc;

                set_motors(lm, rm);

                sprintf(serial_string, "lm: %3d rm: %3d\n", lm, rm);
                serial0_print_string(serial_string);
            }
        }
    }
    return(0);
}

void set_motors(int16_t lm, int16_t rm)
{
    OCR3A = (int32_t)abs(lm) * 9999 / 126;
    OCR3B = (int32_t)abs(rm) * 9999 / 126;

    // Left motor direction
    if(lm >= 0)
    {
        PORTA |=  (1 << PA0);
        PORTA &= ~(1 << PA1);
    }
    else
    {
        PORTA &= ~(1 << PA0);
        PORTA |=  (1 << PA1);
    }

    // Right motor direction
    if(rm >= 0)
    {
        PORTA |=  (1 << PA2);
        PORTA &= ~(1 << PA3);
    }
    else
    {
        PORTA &= ~(1 << PA2);
        PORTA |=  (1 << PA3);
    }
}

void motor_pwm_init(void)
{
    // OC3A = PB6 (D12) = left motor PWM
    // OC3B = PB7 (D13) = right motor PWM
    TCCR3A = (1 << COM3A1) | (1 << COM3B1) | (1 << WGM31);
    TCCR3B = (1 << WGM33)  | (1 << CS31);
    ICR3   = 9999;
    OCR3A  = 0;
    OCR3B  = 0;
}

void GPIO_init(void)
{
    // PA0-PA3: H-bridge direction pins
    DDRA |= (1 << DDA0) | (1 << DDA1) | (1 << DDA2) | (1 << DDA3);

    // PE3 (D5) = OC3A = left motor PWM
    // PE4 (D2) = OC3B = right motor PWM
    DDRE |= (1 << PE3) | (1 << PE4);

    PORTE = 0;
}
