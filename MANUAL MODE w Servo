/*
 * Robot.c  -  motor control + servo driven by controller packet
 *
 * WIRING:
 *   Servo signal -> D5  (PE3 / OC3A)
 *   Servo VCC    -> 5V
 *   Servo GND    -> GND
 *
 * PACKET FORMAT from controller:
 *   [databyte1, right_wheel, left_wheel, checksum]
 *   databyte1 bits 1:0 = 0x02 (packet type)
 *   databyte1 bit  2   = servo_open flag
 *
 * SERVO:
 *   Timer 3, Fast PWM, ICR3=39999, prescaler /8 @ 16MHz = 50Hz, tick = 0.5us
 *   Closed (0 deg)  = 2000 ticks (1.0 ms)
 *   Open   (45 deg) = 3000 ticks (1.5 ms)
 *
 * MOTORS:
 *   Timer 1, Fast PWM on OC1A (PB5) and OC1B (PB6), prescaler /8
 *   Direction pins on PA0-PA3
 */

#include "Robot.h"

#define SERVO_TOP     39999
#define SERVO_CLOSED  2000
#define SERVO_OPEN    3000

void motor_pwm_init(void);
void servo_pwm_init(void);
void GPIO_init(void);
void set_motors(int16_t lm, int16_t rm);

int main(void)
{
    cli();
    _delay_ms(20);
    serial0_init();
    serial2_init();
    _delay_ms(20);
    GPIO_init();
    adc_init();
    motor_pwm_init();
    servo_pwm_init();
    milliseconds_init();

    char     serial_string[60] = {0};
    uint8_t  command           = 0;
    uint8_t  receivedData[4];
    uint16_t last_send_ms      = 0;
    uint8_t  last_servo_state  = 0xFF;   /* force update on first packet */

    sei();

    serial0_print_string("Robot ready\n");

    while (1)
    {
        uint16_t current_ms = milliseconds_now();

        /* ---- Battery voltage telemetry ---- */
        uint16_t adcVal = adc_read(1);
        uint32_t pinMV  = (uint32_t)adcVal * 5000 / 1023 * 2 / 50;

        if ((current_ms - last_send_ms) >= 100)
        {
            sprintf(serial_string, "Sending: %3lu\n", pinMV);
            serial0_print_string(serial_string);

            uint8_t check = 0x10 ^ (uint8_t)pinMV ^ 0xFF;
            serial2_write_bytes(3, 0x10, (uint8_t)pinMV, check);
            last_send_ms = current_ms;
        }

        /* ---- Receive motor + servo commands ---- */
        if (serial2_available())
        {
            serial2_get_data(receivedData, 4);

            if (receivedData[3] == (receivedData[0] ^ receivedData[1] ^ receivedData[2] ^ 0xFF))
                command = receivedData[0] & 0x03;   /* isolate packet type bits */
            else
                command = 0x00;

            if (command == 0x02)
            {
                /* Motors */
                int16_t lm = (int8_t)receivedData[2];
                int16_t rm = (int8_t)receivedData[1];
                set_motors(lm, rm);

                sprintf(serial_string, "lm: %3d rm: %3d\n", lm, rm);
                serial0_print_string(serial_string);

                /* Servo: bit 2 of databyte1 */
                uint8_t servo_open = (receivedData[0] >> 2) & 0x01;

                if (servo_open != last_servo_state)
                {
                    last_servo_state = servo_open;
                    if (servo_open)
                    {
                        OCR3A = SERVO_OPEN;
                        serial0_print_string("Servo: OPEN (45 deg)\n");
                    }
                    else
                    {
                        OCR3A = SERVO_CLOSED;
                        serial0_print_string("Servo: CLOSED (0 deg)\n");
                    }
                }
            }
        }
    }
    return 0;
}

void set_motors(int16_t lm, int16_t rm)
{
    OCR1A = (int32_t)abs(lm) * 9999 / 126;
    OCR1B = (int32_t)abs(rm) * 9999 / 126;

    if (lm <= 0)
    {
        PORTA |=  (1 << PA0);
        PORTA &= ~(1 << PA1);
    }
    else
    {
        PORTA &= ~(1 << PA0);
        PORTA |=  (1 << PA1);
    }

    if (rm <= 0)
    {
        PORTA |=  (1 << PA2);
        PORTA &= ~(1 << PA3);
    }
    else
    {
        PORTA &= ~(1 << PA2);
        PORTA |=  (1 << PA3);
    }
}

void motor_pwm_init(void)
{
    TCCR1A = (1 << COM1A1) | (1 << COM1B1) | (1 << WGM11);
    TCCR1B = (1 << WGM13)  | (1 << CS11);
    ICR1   = 9999;
    OCR1A  = 0;
    OCR1B  = 0;
}

void servo_pwm_init(void)
{
    DDRE |= (1 << DDE3);   /* OC3A output on PE3 (D5) */

    TCCR3A = (1 << COM3A1) | (1 << WGM31);
    TCCR3B = (1 << WGM33)  | (1 << WGM32) | (1 << CS31);
    ICR3   = SERVO_TOP;
    OCR3A  = SERVO_CLOSED;
}

void GPIO_init(void)
{
    /* Motor direction outputs */
    DDRA |= (1 << DDA0) | (1 << DDA1) | (1 << DDA2) | (1 << DDA3);

    /* Motor PWM outputs */
    DDRB |= (1 << DDB5) | (1 << DDB6);
    PORTB = 0;
}

/*
 * Controller.c
 *
 * Reads joystick (PA0/PA1) for motor control.
 * Right joystick button on D21 (PD0 / INT0) toggles servo open/closed.
 * Servo state is packed into bit 2 of databyte1 and sent with every packet.
 *
 * Packet format: [databyte1, right_wheel, left_wheel, checksum]
 *   databyte1 = 0x02 | (servo_open << 2)
 *   checksum  = databyte1 ^ databyte2 ^ databyte3 ^ 0xFF
 */

#include "Controller.h"

volatile uint8_t servo_open = 0;   /* toggled by INT0 ISR */

void GPIO_init(void)
{
    /* Joystick ADC inputs */
    DDRA  = 0x00;
    PORTA = 0x00;

    /* Servo button: PD0 (D21) as input with pull-up */
    DDRD  &= ~(1 << PD0);
    PORTD |=  (1 << PD0);

    /* INT0 on PD0: falling edge (ISC01=1, ISC00=0) */
    EICRA |=  (1 << ISC01);
    EICRA &= ~(1 << ISC00);
    EIMSK |=  (1 << INT0);
}

ISR(INT0_vect)
{
    servo_open = !servo_open;
}

int main(void)
{
    GPIO_init();
    lcd_init();
    _delay_ms(20);
    adc_init();
    _delay_ms(20);
    serial2_init();
    serial0_init();
    milliseconds_init();
    sei();

    uint8_t  databyte1 = 0;
    uint8_t  databyte2 = 0;
    uint8_t  databyte3 = 0;
    uint8_t  receivedData2[3];
    uint16_t last_send_ms = 0;
    char     serial_string[60] = {0};

    lcd_clrscr();
    lcd_home();
    lcd_goto(0x00);
    lcd_puts("init");
    _delay_ms(3000);
    lcd_clrscr();

    while (1)
    {
        uint16_t current_ms = milliseconds_now();

        /* Bit 1:0 = packet type 0x02, bit 2 = servo state */
        databyte1 = 0x02 | (servo_open << 2);

        /* PA1 = Y axis (forward/back), PA0 = X axis (left/right) */
        int16_t x = (int16_t)(adc_read(PA1) >> 2) - 126;
        int16_t y = (int16_t)(adc_read(PA0) >> 2) - 126;

        int16_t left_wheel  = y - x;
        int16_t right_wheel = y + x;

        if (left_wheel  >  100) left_wheel  =  100;
        if (left_wheel  < -100) left_wheel  = -100;
        if (right_wheel >  100) right_wheel =  100;
        if (right_wheel < -100) right_wheel = -100;

        databyte2 = (uint8_t)(right_wheel);
        databyte3 = (uint8_t)(left_wheel);

        if ((current_ms - last_send_ms) >= 100)
        {
            uint8_t check = databyte1 ^ databyte2 ^ databyte3 ^ 0xFF;
            serial2_write_bytes(4, databyte1, databyte2, databyte3, check);
            last_send_ms = current_ms;

            sprintf(serial_string, "L:%4d R:%4d Servo:%s\n",
                    left_wheel, right_wheel, servo_open ? "OPEN" : "CLSD");
            serial0_print_string(serial_string);
        }

        /* Receive voltage telemetry from robot */
        if (serial2_available())
        {
            serial2_get_data(receivedData2, 3);
            lcd_goto(0x00);
            if (receivedData2[2] == (receivedData2[0] ^ receivedData2[1] ^ 0xFF))
            {
                sprintf(serial_string, "Voltage:%5d", receivedData2[1]);
                lcd_puts(serial_string);
            }
        }

        /* Direction display on LCD line 2 */
        lcd_goto(0x40);

        if (abs(y) < 10 && abs(x) < 10)
            lcd_puts("STOP     ");
        else if (abs(x) > abs(y))
            lcd_puts(x > 0 ? "RIGHT    " : "LEFT     ");
        else
            lcd_puts(y < 0 ? "FORWARD  " : "REVERSE  ");
    }
    return 0;
}
